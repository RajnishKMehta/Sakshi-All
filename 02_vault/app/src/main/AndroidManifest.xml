<manifest xmlns:android="http://schemas.android.com/apk/res/android">


    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="Sakshi Vault"
        android:supportsRtl="true">

        <service
            android:name="rajnishkmehta.sakshi.vault.service.SakshiVaultRemoteService"
            android:exported="true"
            >
            <intent-filter>
                <action android:name="rajnishkmehta.sakshi.vault.BIND_VAULT_SERVICE" />
            </intent-filter>
        </service>

        <provider
            android:name=".provider.ThumbnailProvider"
            android:authorities="${applicationId}.thumbnailprovider"
            android:exported="true" />

        <provider
            android:name=".provider.MediaProvider"
            android:authorities="${applicationId}.mediaprovider"
            android:exported="true" />

    </application>

</manifest>
